# GitHub App settings. Create the App first, then copy its slug and webhook secret here.
FORGELOOP_GITHUB_APP_SLUG=your-forgeloop-app-slug
FORGELOOP_GITHUB_APP_ID=your-github-app-id
FORGELOOP_GITHUB_CLIENT_ID=your-github-app-client-id
FORGELOOP_GITHUB_CLIENT_SECRET=replace-with-a-secret-manager-value
# Secret-manager injected PEM in PKCS#8 form; use escaped newlines when supplied as an environment variable.
FORGELOOP_GITHUB_PRIVATE_KEY=-----BEGIN_PRIVATE_KEY-----replace-with-secret-----END_PRIVATE_KEY-----
FORGELOOP_GITHUB_INSTALLATION_STATE_SECRET=replace-with-a-secret-manager-value-at-least-32-characters-long
FORGELOOP_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Conservative policy assigned only when the signed installation_repositories webhook adds a new repository.
FORGELOOP_GITHUB_DEFAULT_ISSUE_LABEL=forgeloop
FORGELOOP_GITHUB_DEFAULT_ORGANIZATION_ID=local-development
FORGELOOP_GITHUB_DEFAULT_HARNESS_PROFILE=GENERIC
FORGELOOP_GITHUB_DEFAULT_REQUIRED_GATES=unit
FORGELOOP_GITHUB_DEFAULT_MAX_BUDGET_USD=25
# Self-hosted browser deployments authenticate operators with GitHub OAuth.
FORGELOOP_SECURITY_MODE=github
# Stable PostgreSQL volume; override only when intentionally restoring a database.
FORGELOOP_POSTGRES_VOLUME=forgeloop-postgres-data
# Required, unique database password; generate with: openssl rand -hex 32
FORGELOOP_DATABASE_PASSWORD=
# Optional loopback diagnostic ports; change these if another local service owns the defaults.
FORGELOOP_POSTGRES_HOST_PORT=5432
FORGELOOP_API_HOST_PORT=8090
FORGELOOP_WEB_HOST_PORT=5173
FORGELOOP_WEBHOOK_HOST_PORT=8091
# Only for a separately managed deployment; the checked-in Compose setup uses GitHub OAuth.
SPRING_PROFILES_ACTIVE=
FORGELOOP_DEVELOPMENT_ORGANIZATION_ID=local-development
# Optional automation access: set both values and use security mode production.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
FORGELOOP_OIDC_AUDIENCE=
# The checked-in Compose stack stores artifacts in its named local volume.
FORGELOOP_ARTIFACT_STORAGE_URI=file:/var/lib/forgeloop/artifacts
# These settings are for a separately managed production deployment, not the default Compose stack.
FORGELOOP_ARTIFACT_S3_REGION=us-east-1
FORGELOOP_ARTIFACT_RETENTION_DAYS=30
FORGELOOP_ARTIFACT_MAX_BYTES=1048576
FORGELOOP_HTTP_REQUESTS_PER_MINUTE=600
# Only ADMIN memberships in this service-owner organization can access the global support inbox.
# Never set this to a customer-controlled organization.
FORGELOOP_SUPPORT_ADMIN_ORGANIZATION_ID=local-development
# Guest support-link recovery is disabled until a verified SMTP sender and canonical HTTPS URL are configured.
FORGELOOP_SUPPORT_RECOVERY_ENABLED=false
FORGELOOP_PUBLIC_BASE_URL=https://forgeloop.example.com
FORGELOOP_SUPPORT_EMAIL_FROM=support@example.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
# Required only when activating the separately managed production Spring profile.
FORGELOOP_ENCRYPTION_KEY=replace-with-a-secret-manager-value-at-least-32-characters-long
SPRING_JPA_DDL_AUTO=validate

# Absolute host path to the named tunnel's JSON credential. Never commit the credential itself.
CLOUDFLARED_CREDENTIALS_FILE=/etc/forgeloop/secrets/credentials.json

# Runner-only provider credential. Inject on the self-hosted runner; the control plane must not receive it.
ANTHROPIC_API_KEY=replace-with-runner-secret

# Standalone MCP gateway. Production uses the OIDC access token of the invoking operator.
FORGELOOP_GRAPHQL_URL=https://forgeloop.example.com/graphql
FORGELOOP_ACCESS_TOKEN=replace-with-a-short-lived-oidc-access-token
# Read-only by default. Add mutating tools only for clients whose operator role permits them.
FORGELOOP_MCP_TOOL_GRANTS=get_run_context,read_verification_evidence,read_audit_timeline
