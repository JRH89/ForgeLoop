type Query { featureRun(id: ID!): FeatureRun!, featureRuns: [FeatureRun!]!, repositoryConnections: [RepositoryConnection!]! }
type Mutation { submitFeature(input: SubmitFeatureInput!): FeatureRun!, connectRepository(input: ConnectRepositoryInput!): RepositoryConnection!, transitionTask(taskId: ID!, to: TaskState!): Task! }
input SubmitFeatureInput { repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float! }
input ConnectRepositoryInput { repository: String!, installationId: Float!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, maxBudgetUsd: Float! }
enum RunState { RECEIVED VALIDATING PLANNING QUEUED EXECUTING INTEGRATING VERIFYING REVIEWING READY_FOR_REVIEW PR_OPEN COMPLETE REJECTED BLOCKED CANCELLED FAILED }
enum TaskState { PENDING LEASED PREPARING RUNNING CHANGE_READY INTEGRATED VERIFIED RETRYABLE_FAILURE REPAIR_QUEUED HELD FAILED }
type FeatureRun { id: ID!, repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float!, harnessProfile: String!, policyRevision: Int!, state: RunState!, createdAt: String!, tasks: [Task!]!, gates: [VerificationGate!]!, criteria: [AcceptanceCriterion!]! }
type RepositoryConnection { id: ID!, repository: String!, installationId: Float!, enabled: Boolean!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, maxBudgetUsd: Float!, policyRevision: Int! }
type Task { id: ID!, role: String!, title: String!, state: TaskState!, attemptBudget: Int!, attempts: Int! }
type VerificationGate { id: ID!, name: String!, required: Boolean!, state: String! }
type AcceptanceCriterion { id: ID!, statement: String!, coverageState: String! }
