type Query { featureRun(id: ID!): FeatureRun!, featureRuns: [FeatureRun!]!, runAnalytics: RunAnalytics!, organizationPolicy: OrganizationPolicy!, harnessDefinitions: [HarnessDefinition!]!, localMcpConfigurations: [LocalMcpConfiguration!]!, repositoryConnections: [RepositoryConnection!]!, repositoryScans(repository: String!): [RepositoryScan!]!, runners(organizationId: String!): [Runner!]!, organizationMemberships(organizationId: String!): [OrganizationMembership!]!, featureRunAuditEvents(runId: ID!): [AuditLedgerEntry!]!, featureRunEvidence(runId: ID!): [VerificationEvidence!]!, featureRunReviewEvidence(runId: ID!): [ReviewEvidence!]!, featureRunArtifacts(runId: ID!): [ArtifactMetadata!]!, featureRunEvents(runId: ID!): [RunnerEvent!]!, featureRunEscalations(runId: ID!): [HumanEscalation!]!, featureRunPublication(runId: ID!): GithubPublication, currentOperator: OperatorSession!, availableRunnerTasks(runnerId: ID!, credential: String!): [Task!]! }
extend type Query { providerActivities(days: Int!, repository: String): [ProviderActivity!]! }
extend type Query { issueConversations(repository: String!): [IssueConversation!]!, issueConversation(id: ID!): IssueConversation! }
extend type Mutation { startIssueConversation(repository: String!, message: String!): IssueConversation!, sendIssueConversationMessage(conversationId: ID!, message: String!): IssueConversation!, createIssueFromConversation(conversationId: ID!, title: String!, body: String!, acceptanceCriteria: [String!]!): IssueConversation!, claimIssueChatTurn(runnerId: ID!, credential: String!): IssueChatTurnGrant, completeIssueChatTurn(conversationId: ID!, runnerId: ID!, credential: String!, input: IssueChatTurnResultInput!): IssueConversation! }
type IssueConversation { id: ID!, repository: String!, status: String!, createdAt: String!, updatedAt: String!, failureSummary: String, draftTitle: String, draftBody: String, acceptanceCriteria: [String!]!, provider: String, model: String, inputTokens: Float!, outputTokens: Float!, estimatedCostMicros: Float!, costKnown: Boolean!, issueNumber: Int, issueUrl: String, messages: [IssueChatMessage!]! }
type IssueChatMessage { role: String!, content: String!, createdAt: String! }
type IssueChatTurnGrant { id: ID!, repository: String!, draftTitle: String, draftBody: String, acceptanceCriteria: [String!]!, messages: [IssueChatTurnMessage!]! }
type IssueChatTurnMessage { role: String!, content: String! }
input IssueChatTurnResultInput { passed: Boolean!, assistantMessage: String, title: String, body: String, acceptanceCriteria: [String!], provider: String, model: String, inputTokens: Float!, outputTokens: Float!, estimatedCostMicros: Float!, costKnown: Boolean! }
type ProviderActivity { id: ID!, repository: String!, activityType: String!, sourceId: String!, provider: String!, model: String!, inputTokens: Float!, outputTokens: Float!, estimatedCostMicros: Float!, costKnown: Boolean!, recordedAt: String! }
type Mutation {
  submitFeature(input: SubmitFeatureInput!): FeatureRun!
  configureOrganizationPolicy(input: OrganizationPolicyInput!): OrganizationPolicy!
  createHarnessDefinition(input: HarnessDefinitionInput!): HarnessDefinition!
  createLocalMcpConfiguration(input: LocalMcpConfigurationInput!): LocalMcpConfiguration!
  connectRepository(input: ConnectRepositoryInput!): RepositoryConnection!
  configureRepositoryVerification(repository: String!, policies: [VerificationPolicyInput!]!): RepositoryConnection!
  issueRunnerRegistrationToken(organizationId: String!): String!
  registerRunner(input: RegisterRunnerInput!): RunnerEnrollment!
  runnerHeartbeat(runnerId: ID!, credential: String!): Runner!
  grantOrganizationMembership(organizationId: String!, subject: String!, role: OperatorRole!): OrganizationMembership!
  claimTaskLease(taskId: ID!, runnerId: ID!, credential: String!): LeaseGrant!
  acknowledgeTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, runnerRevision: String, runnerJarSha256: String): TaskLease!
  completeTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, passed: Boolean!, category: String): TaskLease!
  completeProviderTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, changeSha: String!): TaskLease!
  issueGithubCheckoutGrant(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): GithubCheckoutGrant!
  issueGithubPushGrant(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): GithubPushGrant!
  completeGithubPush(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, integratedSha: String!): TaskLease!
  submitTaskPlan(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: TaskPlanInput!): FeatureRun!
  recordVerificationEvidence(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: VerificationEvidenceInput!): VerificationEvidence!
  recordReviewEvidence(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: ReviewEvidenceInput!): ReviewEvidence!
  recordProviderAttempt(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: ProviderAttemptInput!): ProviderAttempt!
  retryFeatureTask(taskId: ID!, reason: String!, confirmation: String!): Task!
  approveFeatureRun(runId: ID!, confirmation: String!): FeatureRun!
  overrideVerificationGate(runId: ID!, gate: String!, reason: String!): FeatureRun!
  cancelFeatureRun(runId: ID!, confirmation: String!): FeatureRun!
  acknowledgeEscalation(id: ID!, confirmation: String!): HumanEscalation!
  resolveEscalation(id: ID!, confirmation: String!): HumanEscalation!
  synchronizeGithubInstallation(installationId: Float!): [RepositoryConnection!]!
}
input VerificationPolicyInput { name: String!, kind: String!, imageDigest: String!, command: [String!]!, networkPolicy: String!, timeoutSeconds: Int!, required: Boolean!, criterionCoverage: String!, testReport: String }
extend type Mutation { configureRepositoryTestFirst(repository: String!, testGate: String, testPaths: [String!]!): RepositoryConnection!, archiveFeatureRun(runId: ID!, archived: Boolean!): FeatureRun!, deleteFeatureRun(runId: ID!): Boolean!, configureRepositoryIntake(repository: String!, requireAssignee: Boolean!, requiredAssignee: String): RepositoryConnection!, requestRepositoryScan(repository: String!): RepositoryScan!, requestRepositoryIssueProposal(scanId: ID!, findingId: ID!): RepositoryIssueProposal!, approveRepositoryIssueProposal(proposalId: ID!, title: String!, body: String!, acceptanceCriteria: [String!]!): RepositoryIssueProposal!, rejectRepositoryIssueProposal(proposalId: ID!, reason: String): RepositoryIssueProposal!, claimRepositoryScan(runnerId: ID!, credential: String!): RepositoryScanGrant, completeRepositoryScan(scanId: ID!, runnerId: ID!, credential: String!, input: RepositoryScanResultInput!): RepositoryScan!, claimRepositoryIssueProposal(runnerId: ID!, credential: String!): RepositoryIssueProposalGrant, completeRepositoryIssueProposal(proposalId: ID!, runnerId: ID!, credential: String!, input: RepositoryIssueProposalResultInput!): RepositoryIssueProposal! }
extend type FeatureRun { archived: Boolean! }
extend type Mutation { approveRunnerPairing(challenge: String!, name: String!): Boolean!, exchangeRunnerPairing(verifier: String!): RunnerEnrollment }
extend type RepositoryConnection { requiredAssignee: String, requireAssignee: Boolean! }
extend type Mutation {
  configureRepositoryAgentLoop(repository: String!, budget: AgentLoopBudgetInput): RepositoryConnection!
  configureRepositoryEnforcement(repository: String!, input: RepositoryEnforcementInput!): RepositoryConnection!
  renewTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): TaskLease!
  holdTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, reason: String!, summary: String!): TaskLease!
  reserveTaskSpend(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, micros: Float!): SpendReservation!
}
extend type RepositoryConnection { agentLoop: AgentLoopBudget }
extend type RepositoryConnection { enforcement: LoopEnforcement! }
extend type Task { agentLoop: TaskAgentLoop }
extend type Task { redPrerequisite: RedPrerequisite }
type AgentLoopBudget { maxToolCalls: Int!, maxTokens: Int!, maxWallSeconds: Int!, maxConversationBytes: Int! }
type AgentLoopGate { name: String!, kind: String!, imageDigest: String!, command: [String!]!, networkPolicy: String!, timeoutSeconds: Int! }
type TaskAgentLoop { budget: AgentLoopBudget!, gates: [AgentLoopGate!]!, enforcement: LoopEnforcement! }
type LoopEnforcement { protectedPaths: [String!]!, allowWorkflowChanges: Boolean!, finishGate: String }
type RedPrerequisite { testTaskId: ID, targetSha: String, evidenceDigest: String }
type SpendReservation { granted: Boolean!, reservedMicros: Float!, taskRemainingMicros: Float, runRemainingMicros: Float! }
input AgentLoopBudgetInput { maxToolCalls: Int!, maxTokens: Int!, maxWallSeconds: Int!, maxConversationBytes: Int! }
input RepositoryEnforcementInput { protectedPaths: [String!]!, allowWorkflowChanges: Boolean!, finishGate: String }
input VerificationEvidenceInput { kind: String!, gate: String!, image: String!, command: [String!]!, exitCode: Int!, timedOut: Boolean!, output: String!, startedAt: String!, finishedAt: String!, artifactReference: String, outputDigest: String!, bundleDigest: String!, targetSha: String, imageId: String, outputTruncated: Boolean }
input ReviewCriterionInput { statement: String!, status: String!, evidence: String! }
input ReviewEvidenceInput { approved: Boolean!, summary: String!, criteria: [ReviewCriterionInput!]! }
input ProviderAttemptInput { provider: String!, model: String!, requestIdDigest: String!, inputTokens: Float!, outputTokens: Float!, attemptCount: Int!, estimatedCostMicros: Float!, costKnown: Boolean!, outcome: String!, retryable: Boolean!, category: String!, answeredModel: String }
input TaskPlanInput { acceptanceCriteria: [String!]!, tasks: [PlannedTaskInput!]! }
input PlannedTaskInput { key: String!, role: String!, title: String!, requiredCapability: String!, dependencies: [String!]!, ownedPaths: [String!]!, attemptBudget: Int!, budgetMicros: Float! }
input SubmitFeatureInput { repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float! }
input ConnectRepositoryInput { repository: String!, installationId: Float!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, maxBudgetUsd: Float! }
input RegisterRunnerInput { token: String!, name: String!, version: String!, capabilities: [String!]! }
input OrganizationPolicyInput { maxRunBudgetUsd: Float!, maxParallelTasks: Int!, allowedProviders: [String!]!, requireHumanApproval: Boolean!, autoMergeEnabled: Boolean! }
input HarnessDefinitionInput { name: String!, description: String!, allowedRoles: [String!]!, defaultAttemptBudget: Int! }
input LocalMcpConfigurationInput { name: String!, command: String!, arguments: [String!]!, allowedRoles: [String!]!, contextTool: String!, toolArguments: String! }
enum RunState { RECEIVED VALIDATING PLANNING QUEUED EXECUTING INTEGRATING VERIFYING REVIEWING READY_FOR_REVIEW PR_OPEN COMPLETE REJECTED BLOCKED CANCELLED FAILED }
enum AttemptOutcome { CLEAN FINDINGS HARNESS_FAILURE STOPPED }
enum OperatorRole { ADMIN OPERATOR VIEWER }
enum TaskState { PENDING LEASED PREPARING RUNNING CHANGE_READY INTEGRATED VERIFIED RETRYABLE_FAILURE REPAIR_QUEUED HELD FAILED }
type FeatureRun { id: ID!, repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float!, spentCostMicros: Float!, harnessProfile: String!, baseBranch: String!, policyRevision: Int!, policySnapshotSha256: String, state: RunState!, exitMeaning: AttemptOutcome, exitReason: String, createdAt: String!, approved: Boolean!, approvedAt: String, approvedBy: String, publication: GithubPublication, tasks: [Task!]!, gates: [VerificationGate!]!, criteria: [AcceptanceCriterion!]! }
type RepositoryConnection { id: ID!, repository: String!, installationId: Float!, enabled: Boolean!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, verificationPolicies: [VerificationPolicy!]!, maxBudgetUsd: Float!, policyRevision: Int!, testFirstGate: String, testPathGlobs: [String!]! }
type RepositoryScan { id: ID!, repository: String!, baseBranch: String!, status: String!, requestedBy: String!, createdAt: String!, startedAt: String, completedAt: String, commitSha: String, provider: String, model: String, inputTokens: Float!, outputTokens: Float!, estimatedCostMicros: Float!, costKnown: Boolean!, failureSummary: String, findings: [RepositoryScanFinding!]! }
type RepositoryScanFinding { id: ID!, severity: String!, title: String!, description: String!, impact: String!, evidence: String!, affectedFiles: [String!]!, acceptanceCriteria: [String!]!, issueNumber: Int, issueUrl: String, proposal: RepositoryIssueProposal }
type RepositoryScanGrant { id: ID!, repository: String!, baseBranch: String!, token: String! }
input RepositoryScanFindingInput { severity: String!, title: String!, description: String!, impact: String!, evidence: String!, affectedFiles: [String!]!, acceptanceCriteria: [String!]! }
input RepositoryScanResultInput { passed: Boolean!, commitSha: String, provider: String, model: String, inputTokens: Float!, outputTokens: Float!, estimatedCostMicros: Float!, costKnown: Boolean!, failureSummary: String, findings: [RepositoryScanFindingInput!]! }
type RepositoryIssueProposal { id: ID!, repository: String!, status: String!, createdAt: String!, startedAt: String, completedAt: String, failureSummary: String, proposedTitle: String, proposedBody: String, acceptanceCriteria: [String!]!, provider: String, model: String, inputTokens: Float!, outputTokens: Float!, estimatedCostMicros: Float!, costKnown: Boolean!, issueNumber: Int, issueUrl: String }
type RepositoryIssueProposalGrant { id: ID!, repository: String!, commitSha: String!, severity: String!, findingTitle: String!, description: String!, impact: String!, evidence: String!, affectedFiles: [String!]!, acceptanceCriteria: [String!]! }
input RepositoryIssueProposalResultInput { passed: Boolean!, title: String, body: String, acceptanceCriteria: [String!], provider: String, model: String, inputTokens: Float!, outputTokens: Float!, estimatedCostMicros: Float!, costKnown: Boolean! }
type VerificationPolicy { name: String!, kind: String!, imageDigest: String!, command: [String!]!, networkPolicy: String!, timeoutSeconds: Int!, required: Boolean!, criterionCoverage: String!, testReport: String }
type Runner { id: ID!, organizationId: String!, name: String!, version: String!, capabilities: [String!]!, registeredAt: String!, lastHeartbeatAt: String!, enabled: Boolean! }
type RunnerEnrollment { runner: Runner!, credential: String! }
type OrganizationMembership { id: ID!, organizationId: String!, organizationName: String!, subject: String!, githubLogin: String, role: OperatorRole!, accepted: Boolean! }

extend type Mutation {
  inviteGithubUser(organizationId: String!, login: String!, role: OperatorRole!): OrganizationMembership!
  revokeOrganizationMembership(organizationId: String!, membershipId: ID!): Boolean!
  selectOrganization(organizationId: String!): OperatorSession!
}

extend type Query { myOrganizationMemberships: [OrganizationMembership!]! }
type OperatorSession { subject: String!, organizationId: String!, role: OperatorRole! }
type AuditLedgerEntry { id: ID!, actor: String!, action: String!, resourceType: String!, resourceId: String!, payloadDigest: String!, occurredAt: String! }
type GithubPublication { id: ID!, featureRunId: ID!, repository: String!, branch: String!, idempotencyKey: String!, headSha: String, checkRunId: Float, pullRequestNumber: Float, pullRequestState: String!, deliveredAt: String, autoMergeRequested: Boolean!, mergedAt: String, mergeSha: String }
type TaskLease { id: ID!, taskId: ID!, runnerId: ID!, expiresAt: String!, acknowledged: Boolean!, completed: Boolean!, runnerRevision: String, runnerJarSha256: String, inputRefs: String, resultSha: String }
type LeaseGrant { lease: TaskLease!, nonce: String! }
type GithubPushGrant { repository: String!, branch: String!, expectedHeadSha: String, token: String! }
type GithubCheckoutGrant { repository: String!, baseBranch: String!, token: String! }
type Task { id: ID!, planKey: String!, role: String!, executionRole: String!, title: String!, repository: String!, baseBranch: String!, executionBaseRef: String!, sourceRef: String!, specification: String!, executionSpecification: String!, acceptanceCriteria: [String!]!, budgetUsd: Float!, requiredCapability: String!, state: TaskState!, attemptBudget: Int!, attempts: Int!, budgetMicros: Float!, spentCostMicros: Float!, changeSha: String, ownedPaths: [String!]!, dependencyKeys: [String!]!, dependencyChangeShas: [String!]!, verificationGateName: String, verificationKind: String, verificationImageDigest: String, verificationCommand: [String!]!, verificationNetworkPolicy: String, verificationTimeoutSeconds: Int, verificationBaseRef: String!, writeBoundary: String!, testPathGlobs: [String!]!, testReportFormat: String, expectedTests: [String!]!, expectedTestsOverflow: Boolean!, testFirstEvidence: String, mcpConfigurations: [LocalMcpConfiguration!]!, providerAttempts: [ProviderAttempt!]!, repairPackages: [RepairPackage!]! }
type VerificationGate { id: ID!, name: String!, required: Boolean!, state: String!, kind: String, imageDigest: String, command: [String!]!, networkPolicy: String, timeoutSeconds: Int, criterionCoverage: String, testReport: String }
type AcceptanceCriterion { id: ID!, statement: String!, coverageState: String! }
type VerificationEvidence { id: ID!, taskId: ID!, runnerId: ID!, leaseId: ID, kind: String!, gate: String!, image: String!, command: [String!]!, exitCode: Int!, timedOut: Boolean!, output: String!, digest: String!, startedAt: String!, finishedAt: String!, artifactReference: String, outputDigest: String!, bundleDigest: String!, targetSha: String, imageId: String, outputTruncated: Boolean, recordedAt: String! }
type ArtifactMetadata { id: ID!, organizationId: String!, runId: ID!, taskId: ID!, leaseId: ID!, storageReference: String!, contentType: String!, artifactType: String!, displayName: String!, sizeBytes: Float!, sha256: String!, retentionClass: String!, retainUntil: String!, createdAt: String! }
type ReviewEvidence { id: ID!, taskId: ID!, runnerId: ID!, approved: Boolean!, summary: String!, digest: String!, recordedAt: String!, criteria: [ReviewCriterionAssessment!]! }
type ReviewCriterionAssessment { id: ID!, statement: String!, status: String!, evidence: String! }
type ProviderAttempt { id: ID!, taskId: ID!, runnerId: ID!, leaseId: ID, provider: String!, model: String!, answeredModel: String, requestIdDigest: String!, inputTokens: Float!, outputTokens: Float!, attemptCount: Int!, estimatedCostMicros: Float!, costKnown: Boolean!, outcome: String!, retryable: Boolean!, category: String!, recordedAt: String! }
type RepairPackage { id: ID!, taskId: ID!, attempt: Int!, failureCategory: String!, changeSha: String, evidenceDigest: String, ownedPaths: [String!]!, acceptanceCriteria: [String!]!, createdAt: String! }
type RunnerEvent { id: ID!, runId: ID!, taskId: ID!, runnerId: ID!, leaseId: ID!, sequenceNumber: Float!, level: String!, eventType: String!, message: String!, occurredAt: String!, receivedAt: String! }
type HumanEscalation { id: ID!, runId: ID!, taskId: ID, reason: String!, severity: String!, status: String!, summary: String!, createdAt: String!, acknowledgedAt: String, acknowledgedBy: String, resolvedAt: String, resolvedBy: String }
type RunAnalytics { totalRuns: Float!, activeRuns: Float!, deliveredRuns: Float!, providerRequests: Float!, inputTokens: Float!, outputTokens: Float!, knownCostMicros: Float!, costCoverage: Float!, modelComparisons: [RunComparison!]!, harnessComparisons: [RunComparison!]! }
type RunComparison { dimension: String!, name: String!, runCount: Float!, requestCount: Float!, successfulRequests: Float!, inputTokens: Float!, outputTokens: Float!, knownCostMicros: Float! }
type OrganizationPolicy { organizationId: ID!, maxRunBudgetUsd: Float!, maxParallelTasks: Int!, allowedProviders: [String!]!, requireHumanApproval: Boolean!, autoMergeEnabled: Boolean!, revision: Int! }
type HarnessDefinition { id: ID!, organizationId: ID!, name: String!, description: String!, allowedRoles: [String!]!, defaultAttemptBudget: Int!, enabled: Boolean!, revision: Int! }
type LocalMcpConfiguration { id: ID!, name: String!, command: String!, arguments: [String!]!, allowedRoles: [String!]!, contextTool: String!, toolArguments: String!, enabled: Boolean!, revision: Int! }

extend type Query { issueIntakeCheck(repository: String!, issueNumber: Int!): IssueIntakeCheck! }
extend type Query { featureRunTestEvidence(runId: ID!): [TestCheckEvidence!]! }
extend type Mutation { recordTestCheckEvidence(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: TestCheckEvidenceInput!): TestCheckEvidence! }
input TestCheckEvidenceInput { artifactReference: String!, bundleDigest: String! }
type TestCheckEvidence { id: ID!, taskId: ID!, runnerId: ID!, kind: String!, gate: String!, image: String!, command: [String!]!, targetSha: String!, parentSha: String, verdict: String!, reason: String!, beforeStatus: String, afterStatus: String!, beforeExitCode: Int, afterExitCode: Int!, beforeTimedOut: Boolean!, afterTimedOut: Boolean!, beforeTotal: Int, beforePassed: Int, beforeFailed: Int, beforeErrored: Int, beforeSkipped: Int, afterTotal: Int!, afterPassed: Int!, afterFailed: Int!, afterErrored: Int!, afterSkipped: Int!, redTests: [String!]!, failingTests: [String!]!, classifiedTests: String!, changedFiles: String!, beforeOutcomeDigest: String, afterOutcomeDigest: String!, beforeOutputDigest: String, afterOutputDigest: String!, artifactReference: String!, bundleDigest: String!, digest: String!, recordedAt: String! }
type IssueIntakeCheck { eligible: Boolean!, reasons: [String!]!, checkedAt: String! }
