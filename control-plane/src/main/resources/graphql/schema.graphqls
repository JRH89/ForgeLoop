type Query { featureRun(id: ID!): FeatureRun!, featureRuns: [FeatureRun!]!, runAnalytics: RunAnalytics!, organizationPolicy: OrganizationPolicy!, harnessDefinitions: [HarnessDefinition!]!, localMcpConfigurations: [LocalMcpConfiguration!]!, repositoryConnections: [RepositoryConnection!]!, runners(organizationId: String!): [Runner!]!, organizationMemberships(organizationId: String!): [OrganizationMembership!]!, featureRunAuditEvents(runId: ID!): [AuditLedgerEntry!]!, featureRunEvidence(runId: ID!): [VerificationEvidence!]!, featureRunReviewEvidence(runId: ID!): [ReviewEvidence!]!, featureRunArtifacts(runId: ID!): [ArtifactMetadata!]!, featureRunEvents(runId: ID!): [RunnerEvent!]!, featureRunEscalations(runId: ID!): [HumanEscalation!]!, featureRunPublication(runId: ID!): GithubPublication, currentOperator: OperatorSession!, availableRunnerTasks(runnerId: ID!, credential: String!): [Task!]! }
type Mutation { submitFeature(input: SubmitFeatureInput!): FeatureRun!, configureOrganizationPolicy(input: OrganizationPolicyInput!): OrganizationPolicy!, createHarnessDefinition(input: HarnessDefinitionInput!): HarnessDefinition!, createLocalMcpConfiguration(input: LocalMcpConfigurationInput!): LocalMcpConfiguration!, connectRepository(input: ConnectRepositoryInput!): RepositoryConnection!, configureRepositoryVerification(repository: String!, policies: [VerificationPolicyInput!]!): RepositoryConnection!, issueRunnerRegistrationToken(organizationId: String!): String!, registerRunner(input: RegisterRunnerInput!): RunnerEnrollment!, runnerHeartbeat(runnerId: ID!, credential: String!): Runner!, grantOrganizationMembership(organizationId: String!, subject: String!, role: OperatorRole!): OrganizationMembership!, claimTaskLease(taskId: ID!, runnerId: ID!, credential: String!): LeaseGrant!, acknowledgeTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): TaskLease!, completeTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, passed: Boolean!): TaskLease!, completeProviderTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, changeSha: String!): TaskLease!, issueGithubCheckoutGrant(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): GithubCheckoutGrant!, issueGithubPushGrant(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): GithubPushGrant!, completeGithubPush(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, integratedSha: String!): TaskLease!, submitTaskPlan(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: TaskPlanInput!): FeatureRun!, recordVerificationEvidence(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: VerificationEvidenceInput!): VerificationEvidence!, recordReviewEvidence(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: ReviewEvidenceInput!): ReviewEvidence!, recordProviderAttempt(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: ProviderAttemptInput!): ProviderAttempt!, retryFeatureTask(taskId: ID!, reason: String!, confirmation: String!): Task!, approveFeatureRun(runId: ID!, confirmation: String!): FeatureRun!, overrideVerificationGate(runId: ID!, gate: String!, reason: String!): FeatureRun!, cancelFeatureRun(runId: ID!, confirmation: String!): FeatureRun!, acknowledgeEscalation(id: ID!, confirmation: String!): HumanEscalation!, resolveEscalation(id: ID!, confirmation: String!): HumanEscalation!, synchronizeGithubInstallation(installationId: Float!): [RepositoryConnection!]! }
input VerificationPolicyInput { name: String!, kind: String!, imageDigest: String!, command: [String!]!, networkPolicy: String!, timeoutSeconds: Int!, required: Boolean!, criterionCoverage: String! }
input VerificationEvidenceInput { kind: String!, gate: String!, image: String!, command: [String!]!, exitCode: Int!, timedOut: Boolean!, output: String!, startedAt: String!, finishedAt: String!, artifactReference: String, outputDigest: String!, bundleDigest: String! }
input ReviewCriterionInput { statement: String!, status: String!, evidence: String! }
input ReviewEvidenceInput { approved: Boolean!, summary: String!, criteria: [ReviewCriterionInput!]! }
input ProviderAttemptInput { provider: String!, model: String!, requestIdDigest: String!, inputTokens: Float!, outputTokens: Float!, attemptCount: Int!, estimatedCostMicros: Float!, costKnown: Boolean!, outcome: String!, retryable: Boolean!, category: String! }
input TaskPlanInput { acceptanceCriteria: [String!]!, tasks: [PlannedTaskInput!]! }
input PlannedTaskInput { key: String!, role: String!, title: String!, requiredCapability: String!, dependencies: [String!]!, ownedPaths: [String!]!, attemptBudget: Int!, budgetMicros: Float! }
input SubmitFeatureInput { repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float! }
input ConnectRepositoryInput { repository: String!, installationId: Float!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, maxBudgetUsd: Float! }
input RegisterRunnerInput { token: String!, name: String!, version: String!, capabilities: [String!]! }
input OrganizationPolicyInput { maxRunBudgetUsd: Float!, maxParallelTasks: Int!, allowedProviders: [String!]!, requireHumanApproval: Boolean!, autoMergeEnabled: Boolean! }
input HarnessDefinitionInput { name: String!, description: String!, allowedRoles: [String!]!, defaultAttemptBudget: Int! }
input LocalMcpConfigurationInput { name: String!, command: String!, arguments: [String!]!, allowedRoles: [String!]!, contextTool: String!, toolArguments: String! }
enum RunState { RECEIVED VALIDATING PLANNING QUEUED EXECUTING INTEGRATING VERIFYING REVIEWING READY_FOR_REVIEW PR_OPEN COMPLETE REJECTED BLOCKED CANCELLED FAILED }
enum OperatorRole { ADMIN OPERATOR VIEWER }
enum TaskState { PENDING LEASED PREPARING RUNNING CHANGE_READY INTEGRATED VERIFIED RETRYABLE_FAILURE REPAIR_QUEUED HELD FAILED }
type FeatureRun { id: ID!, repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float!, spentCostMicros: Float!, harnessProfile: String!, baseBranch: String!, policyRevision: Int!, state: RunState!, createdAt: String!, approved: Boolean!, approvedAt: String, approvedBy: String, tasks: [Task!]!, gates: [VerificationGate!]!, criteria: [AcceptanceCriterion!]! }
type RepositoryConnection { id: ID!, repository: String!, installationId: Float!, enabled: Boolean!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, verificationPolicies: [VerificationPolicy!]!, maxBudgetUsd: Float!, policyRevision: Int! }
type VerificationPolicy { name: String!, kind: String!, imageDigest: String!, command: [String!]!, networkPolicy: String!, timeoutSeconds: Int!, required: Boolean!, criterionCoverage: String! }
type Runner { id: ID!, organizationId: String!, name: String!, version: String!, capabilities: [String!]!, registeredAt: String!, lastHeartbeatAt: String!, enabled: Boolean! }
type RunnerEnrollment { runner: Runner!, credential: String! }
type OrganizationMembership { id: ID!, subject: String!, role: OperatorRole! }
type OperatorSession { subject: String!, organizationId: String!, role: OperatorRole! }
type AuditLedgerEntry { id: ID!, actor: String!, action: String!, resourceType: String!, resourceId: String!, payloadDigest: String!, occurredAt: String! }
type GithubPublication { id: ID!, featureRunId: ID!, repository: String!, branch: String!, idempotencyKey: String!, headSha: String, checkRunId: Float, pullRequestNumber: Float, deliveredAt: String, autoMergeRequested: Boolean!, mergedAt: String, mergeSha: String }
type TaskLease { id: ID!, taskId: ID!, runnerId: ID!, expiresAt: String!, acknowledged: Boolean!, completed: Boolean! }
type LeaseGrant { lease: TaskLease!, nonce: String! }
type GithubPushGrant { repository: String!, branch: String!, expectedHeadSha: String, token: String! }
type GithubCheckoutGrant { repository: String!, baseBranch: String!, token: String! }
type Task { id: ID!, planKey: String!, role: String!, executionRole: String!, title: String!, repository: String!, baseBranch: String!, executionBaseRef: String!, sourceRef: String!, specification: String!, executionSpecification: String!, acceptanceCriteria: [String!]!, budgetUsd: Float!, requiredCapability: String!, state: TaskState!, attemptBudget: Int!, attempts: Int!, budgetMicros: Float!, spentCostMicros: Float!, changeSha: String, ownedPaths: [String!]!, dependencyKeys: [String!]!, dependencyChangeShas: [String!]!, verificationGateName: String, verificationKind: String, verificationImageDigest: String, verificationCommand: [String!]!, verificationNetworkPolicy: String, verificationTimeoutSeconds: Int, verificationBaseRef: String!, mcpConfigurations: [LocalMcpConfiguration!]!, providerAttempts: [ProviderAttempt!]!, repairPackages: [RepairPackage!]! }
type VerificationGate { id: ID!, name: String!, required: Boolean!, state: String!, kind: String, imageDigest: String, command: [String!]!, networkPolicy: String, timeoutSeconds: Int, criterionCoverage: String }
type AcceptanceCriterion { id: ID!, statement: String!, coverageState: String! }
type VerificationEvidence { id: ID!, taskId: ID!, runnerId: ID!, kind: String!, gate: String!, image: String!, command: [String!]!, exitCode: Int!, timedOut: Boolean!, output: String!, digest: String!, startedAt: String!, finishedAt: String!, artifactReference: String, outputDigest: String!, bundleDigest: String!, recordedAt: String! }
type ArtifactMetadata { id: ID!, organizationId: String!, runId: ID!, taskId: ID!, leaseId: ID!, storageReference: String!, contentType: String!, artifactType: String!, displayName: String!, sizeBytes: Float!, sha256: String!, retentionClass: String!, retainUntil: String!, createdAt: String! }
type ReviewEvidence { id: ID!, taskId: ID!, runnerId: ID!, approved: Boolean!, summary: String!, digest: String!, recordedAt: String!, criteria: [ReviewCriterionAssessment!]! }
type ReviewCriterionAssessment { id: ID!, statement: String!, status: String!, evidence: String! }
type ProviderAttempt { id: ID!, taskId: ID!, runnerId: ID!, provider: String!, model: String!, requestIdDigest: String!, inputTokens: Float!, outputTokens: Float!, attemptCount: Int!, estimatedCostMicros: Float!, costKnown: Boolean!, outcome: String!, retryable: Boolean!, category: String!, recordedAt: String! }
type RepairPackage { id: ID!, taskId: ID!, attempt: Int!, failureCategory: String!, changeSha: String, evidenceDigest: String, ownedPaths: [String!]!, acceptanceCriteria: [String!]!, createdAt: String! }
type RunnerEvent { id: ID!, runId: ID!, taskId: ID!, runnerId: ID!, leaseId: ID!, sequenceNumber: Float!, level: String!, eventType: String!, message: String!, occurredAt: String!, receivedAt: String! }
type HumanEscalation { id: ID!, runId: ID!, taskId: ID, reason: String!, severity: String!, status: String!, summary: String!, createdAt: String!, acknowledgedAt: String, acknowledgedBy: String, resolvedAt: String, resolvedBy: String }
type RunAnalytics { totalRuns: Float!, activeRuns: Float!, deliveredRuns: Float!, providerRequests: Float!, inputTokens: Float!, outputTokens: Float!, knownCostMicros: Float!, costCoverage: Float!, modelComparisons: [RunComparison!]!, harnessComparisons: [RunComparison!]! }
type RunComparison { dimension: String!, name: String!, runCount: Float!, requestCount: Float!, successfulRequests: Float!, inputTokens: Float!, outputTokens: Float!, knownCostMicros: Float! }
type OrganizationPolicy { organizationId: ID!, maxRunBudgetUsd: Float!, maxParallelTasks: Int!, allowedProviders: [String!]!, requireHumanApproval: Boolean!, autoMergeEnabled: Boolean!, revision: Int! }
type HarnessDefinition { id: ID!, organizationId: ID!, name: String!, description: String!, allowedRoles: [String!]!, defaultAttemptBudget: Int!, enabled: Boolean!, revision: Int! }
type LocalMcpConfiguration { id: ID!, name: String!, command: String!, arguments: [String!]!, allowedRoles: [String!]!, contextTool: String!, toolArguments: String!, enabled: Boolean!, revision: Int! }
