type Query { featureRun(id: ID!): FeatureRun!, featureRuns: [FeatureRun!]!, repositoryConnections: [RepositoryConnection!]!, runners(organizationId: String!): [Runner!]!, organizationMemberships(organizationId: String!): [OrganizationMembership!]!, featureRunAuditEvents(runId: ID!): [AuditLedgerEntry!]!, availableRunnerTasks(runnerId: ID!, credential: String!): [Task!]! }
type Mutation { submitFeature(input: SubmitFeatureInput!): FeatureRun!, connectRepository(input: ConnectRepositoryInput!): RepositoryConnection!, issueRunnerRegistrationToken(organizationId: String!): String!, registerRunner(input: RegisterRunnerInput!): RunnerEnrollment!, runnerHeartbeat(runnerId: ID!, credential: String!): Runner!, grantOrganizationMembership(organizationId: String!, subject: String!, role: OperatorRole!): OrganizationMembership!, claimTaskLease(taskId: ID!, runnerId: ID!, credential: String!): LeaseGrant!, acknowledgeTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): TaskLease!, completeTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, passed: Boolean!): TaskLease!, completeProviderTaskLease(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!): TaskLease!, recordVerificationEvidence(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: VerificationEvidenceInput!): VerificationEvidence!, recordProviderAttempt(leaseId: ID!, runnerId: ID!, nonce: String!, credential: String!, input: ProviderAttemptInput!): ProviderAttempt!, transitionTask(taskId: ID!, to: TaskState!): Task!, recordVerificationGate(runId: ID!, gate: String!, passed: Boolean!): FeatureRun!, cancelFeatureRun(runId: ID!): FeatureRun!, synchronizeGithubInstallation(installationId: Float!): [RepositoryConnection!]!, deliverVerifiedRun(runId: ID!, baseSha: String!, changes: [GithubChangeInput!]!, summary: String!): GithubPublication! }
input VerificationEvidenceInput { kind: String!, gate: String, image: String, command: String!, exitCode: Int!, timedOut: Boolean!, output: String! }
input ProviderAttemptInput { provider: String!, model: String!, requestIdDigest: String!, inputTokens: Float!, outputTokens: Float!, attemptCount: Int!, estimatedCostMicros: Float!, costKnown: Boolean!, outcome: String!, retryable: Boolean!, category: String! }
input SubmitFeatureInput { repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float! }
input ConnectRepositoryInput { repository: String!, installationId: Float!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, maxBudgetUsd: Float! }
input RegisterRunnerInput { token: String!, name: String!, version: String!, capabilities: [String!]! }
input GithubChangeInput { path: String!, content: String!, message: String! }
enum RunState { RECEIVED VALIDATING PLANNING QUEUED EXECUTING INTEGRATING VERIFYING REVIEWING READY_FOR_REVIEW PR_OPEN COMPLETE REJECTED BLOCKED CANCELLED FAILED }
enum OperatorRole { ADMIN OPERATOR VIEWER }
enum TaskState { PENDING LEASED PREPARING RUNNING CHANGE_READY INTEGRATED VERIFIED RETRYABLE_FAILURE REPAIR_QUEUED HELD FAILED }
type FeatureRun { id: ID!, repository: String!, sourceRef: String!, title: String!, specification: String!, budgetUsd: Float!, harnessProfile: String!, baseBranch: String!, policyRevision: Int!, state: RunState!, createdAt: String!, tasks: [Task!]!, gates: [VerificationGate!]!, criteria: [AcceptanceCriterion!]! }
type RepositoryConnection { id: ID!, repository: String!, installationId: Float!, enabled: Boolean!, defaultBranch: String!, issueLabel: String!, harnessProfile: String!, requiredGates: [String!]!, maxBudgetUsd: Float!, policyRevision: Int! }
type Runner { id: ID!, organizationId: String!, name: String!, version: String!, capabilities: [String!]!, registeredAt: String!, lastHeartbeatAt: String!, enabled: Boolean! }
type RunnerEnrollment { runner: Runner!, credential: String! }
type OrganizationMembership { id: ID!, subject: String!, role: OperatorRole! }
type AuditLedgerEntry { id: ID!, actor: String!, action: String!, resourceType: String!, resourceId: String!, payloadDigest: String!, occurredAt: String! }
type GithubPublication { id: ID!, featureRunId: ID!, repository: String!, branch: String!, idempotencyKey: String!, headSha: String, checkRunId: Float, pullRequestNumber: Float, deliveredAt: String }
type TaskLease { id: ID!, taskId: ID!, runnerId: ID!, expiresAt: String!, acknowledged: Boolean!, completed: Boolean! }
type LeaseGrant { lease: TaskLease!, nonce: String! }
type Task { id: ID!, role: String!, title: String!, repository: String!, baseBranch: String!, sourceRef: String!, specification: String!, requiredCapability: String!, state: TaskState!, attemptBudget: Int!, attempts: Int!, providerAttempts: [ProviderAttempt!]! }
type VerificationGate { id: ID!, name: String!, required: Boolean!, state: String! }
type AcceptanceCriterion { id: ID!, statement: String!, coverageState: String! }
type VerificationEvidence { id: ID!, taskId: ID!, runnerId: ID!, kind: String!, gate: String, image: String, command: String!, exitCode: Int!, timedOut: Boolean!, output: String!, digest: String!, recordedAt: String! }
type ProviderAttempt { id: ID!, taskId: ID!, runnerId: ID!, provider: String!, model: String!, requestIdDigest: String!, inputTokens: Float!, outputTokens: Float!, attemptCount: Int!, estimatedCostMicros: Float!, costKnown: Boolean!, outcome: String!, retryable: Boolean!, category: String!, recordedAt: String! }
